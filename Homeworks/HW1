############ PROBLEM 5 ########

### Part B ###
x1=np.pi
x2=10**6
d=np.logspace(-16,0,17)

#x1 = pi
diff_x1=[]
for di in d:
    func1=np.cos(x1+di)-np.cos(x1)
    func2=-2*np.sin((2*x1+di)/2)*np.sin(di/2)
    diff_x1.append(abs(func1-func2))

#x2=10^6
diff_x2=[]
for di in d:
    func1=np.cos(x2+di)-np.cos(x2)
    func2=-2*np.sin((2*x2+di)/2)*np.sin(di/2)
    diff_x2.append(abs(func1-func2))

#plotting
fig3=plt.figure(3)
plt.plot(d,diff_x1,label="Error for x=pi")
plt.plot(d,diff_x2,label = "Error for x=10^6")
plt.xlabel('delta')
plt.ylabel('difference between expressions')
plt.xscale('log')
plt.yscale('log')
plt.legend()
plt.show()


### Part C ###
diff_x1_alg=[]
for di in d:
    func1=np.cos(x1+di)-np.cos(x1)
    func2=-di*np.sin(x1)+(di**2/2)
    diff_x1_alg.append(abs(func1-func2))

#x2=10^6
