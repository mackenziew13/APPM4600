import math as math
import numpy as np
import matplotlib.pyplot as plt

def f(x):
    y = math.e**x
    return y - 1

x=9.999999995000000*10**-10
est=f(x)
print('The estimate for f(x) is',est)

##Part D##
a=0
true=math.expm1(x)
P2=(math.e**a-1)+math.e**a*(x-a)+(math.e**a/2)*(x-a)**2
err=abs(P2-true)/abs(true)
print('P2=',P2)
print('The error is',err, 'for P2')


