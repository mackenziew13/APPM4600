############ PROBLEM 3 ########

###PART A###
#create f(x) 
x=np.linspace(-10,10,1000)
def f(x):
    return (1+x+x**3)*np.cos(x)

#use finite difference to find derivative
h=1*10**-5
a=0
f_prime=(f(a+h)-f(a-h))/(2*h)
f_dprime=(f(a+h)-2*f(a)+f(a-h))/(h**2)

#find P2(0.5)
x1=0.5
P2=f(a)+f_prime*(x1-a)+(f_dprime/2)*(x1-a)**2
print("P2(0.5)=",P2)

#upper bound of error
f_tprime_z=3.00909
R2=(f_tprime_z/6)*(x1-a)**3
print("The upper bound for the error is",R2)
#actual error
err_actual=f(0.5)-P2
print("The actual error is",err_actual)
###PART C###

#redefine x and P2
x=np.linspace(0,1,1000)
P2=[]
for xi in x:
    P2.append(f(a)+f_prime*(xi-a)+(f_dprime/2)*(xi-a)**2)

#calculate integral
integral=np.trapezoid(P2,x)
print("The estimate of the integral is",integral)

###Part D###
P2=(x-a)**3
#calculate integral
integral=(f_tprime_z/6)*np.trapezoid(P2,x)
print("The upper bound of the error in the integral is",integral)


